# Database
DATABASE_URL="postgresql://kit:kit@localhost:5433/kit?schema=public"

# Sign-in (OIDC). Locally this points at mock-oauth2-server from docker-compose.
# For Entra ID: OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER="http://localhost:8090/default"
OIDC_CLIENT_ID="internal-tools"
OIDC_CLIENT_SECRET="internal-tools-secret"
OIDC_REDIRECT_URI="http://localhost:3000/api/auth/callback"
SESSION_SECRET="dev-only-session-secret-change-me-please-32b"

# Microsoft Graph (SharePoint). Locally these point at the mock Graph server.
# In a real tenant: GRAPH_BASE_URL=https://graph.microsoft.com
# GRAPH_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
GRAPH_BASE_URL="http://localhost:8095"
GRAPH_TOKEN_URL="http://localhost:8095/token"
GRAPH_CLIENT_ID="internal-tools-graph"
GRAPH_CLIENT_SECRET="internal-tools-graph-secret"
GRAPH_SCOPE="https://graph.microsoft.com/.default"
